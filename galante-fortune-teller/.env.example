# Salesforce
SF_USERNAME=your_username_here
SF_PASSWORD=your_password_here
SF_SECURITY_TOKEN=your_token_here
SF_DOMAIN=login
SF_API_VERSION=59.0

# Slack
SLACK_WEBHOOK_URL=your_webhook_url_here
SLACK_CHANNEL=#sales-forecast

# Anthropic Claude API
ANTHROPIC_API_KEY=your_api_key_here

# Agent Settings
DRY_RUN=false
LOG_LEVEL=INFO
TZ=Asia/Tokyo
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=30
