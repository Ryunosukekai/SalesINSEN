# ── Salesforce ──
SF_USERNAME=your_sf_username@example.com
SF_PASSWORD=your_sf_password
SF_SECURITY_TOKEN=your_security_token
SF_DOMAIN=login                    # 'login' (production) or 'test' (sandbox)

# ── Slack ──
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=#sales-forecast

# ── Forecast Parameters ──
NEW_DEAL_WIN_RATE=0.104            # 新規成約率 10.4%
EXISTING_RETENTION_RATE=0.229      # 既存継続率 22.9%
MONTHLY_SALES_TARGET=10000         # 月次目標 (万円)
AVG_DEAL_SIZE_NEW=500              # 新規平均案件単価 (万円)
AVG_DEAL_SIZE_EXISTING=300         # 既存平均案件単価 (万円)

# ── Scheduler ──
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0
TZ=Asia/Tokyo

# ── General ──
DRY_RUN=false
LOG_LEVEL=INFO
